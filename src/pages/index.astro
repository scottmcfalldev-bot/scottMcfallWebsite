  .savings__total { margin: 0.4rem 0 0; font-family: var(--sc-font-display); font-weight: 800; font-size: var(--sc-t-3xl); color: var(--amber); letter-spacing: var(--sc-track-tight); line-height: 1; font-variant-numeric: tabular-nums; }
  .insights { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.3rem; font-size: var(--sc-t-sm); color: var(--forest-soft); }
