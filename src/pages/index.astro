  .hero-slips { position: absolute; inset: 0; z-index: 3; }
  .slip {
    display: inline-flex; align-items: baseline; gap: 0.8em;
    background: #F7F5F0; color: var(--paper-ink); border: 1px solid #D5D0C7;
    padding: 0.6em 0.9em; border-radius: 3px; font-size: var(--sc-t-sm); font-weight: 500;
