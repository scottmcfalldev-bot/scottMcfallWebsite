---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "What does this cost?",
    a: "The bottleneck call is free. A first automation build is a fixed $2,500 for one workflow, paid 50% up front. Keep It Running is $750 a month. My first three founding clients get the build for $1,500 in exchange for a written case study.",
  },
  {
    q: "Is my client data safe?",
    a: "I work inside your accounts with the least access the job needs, and nothing is copied to my own systems. You can remove my access the day we finish. Happy to sign an NDA before we start.",
  },
  {
    q: "What tools do you use?",
    a: "Whatever fits what you already pay for: Zapier, Make or n8n for the plumbing, Claude for the AI steps, and custom code where those fall short. I connect Asana, Monday, ClickUp, Slack, Google Workspace, HubSpot, Harvest, QuickBooks, Stripe, Airtable and most tools with an API.",
  },
  {
    q: "What happens if it breaks?",
    a: "Every build sends an alert when something fails, so you're not the one who finds out. Fixes are included for 30 days after launch. On Keep It Running, I fix problems within one business day.",
  },
  {
    q: "I'm not technical. Is that a problem?",
    a: "No. You know where the time goes. I handle the tech, and you get a short written guide to what was built and how to change it.",
  },
  {
    q: "How fast?",
    a: "The one-page plan arrives within 48 hours of our call. A build is live in about two weeks.",
  },
  {
    q: "Do you build anything besides automations?",
    a: "Yes. I also build lead-capture tools like calculators and quizzes, and small internal apps. Most agencies start with an automation, though.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const presets = [
  "Status updates across tools",
  "Weekly client reports",
  "New client onboarding setup",
  "Timesheets → invoices",
  "Building proposals",
  "Meeting notes → tasks",
  "Lead follow-up & CRM updates",
  "Copying data between tools",
];

const offer = [
  { name: "Bottleneck call", what: "30 minutes on your team's week. A one-page plan and a fixed price within 48 hours.", price: "Free" },
  { name: "First automation", what: "One workflow built, tested and handed over in about two weeks. 50% to start. Failure alerts and 30 days of fixes included.", price: "$2,500" },
  { name: "Keep it running", what: "Monitoring, fixes within one business day, small tweaks, one small new automation a month. Optional.", price: "$750/mo" },
];

// cat: reporting | content | leads | apps. top: shown under "Highlights".
const work = [
  { id: "formation", cat: "reporting", top: true, title: "Formation Consulting", what: "Monday.com, Harvest, budget spreadsheets and manual invoicing replaced by one integrated system.", tag: "~15 hrs/week saved (estimated)" },
  { id: "stats", cat: "reporting", top: true, title: "Monthly stats dashboard", what: "Pulls a podcast's hosting numbers and builds the month's dashboard on its own, on the 8th of every month, for two Lewis Howes shows.", tag: "The report builds itself" },
  { id: "competitors", cat: "reporting", title: "Competitor tracker", what: "Pulls competitor channel and video stats from the YouTube API into one dashboard.", tag: "One page to check" },
  { id: "digest", cat: "reporting", title: "Industry news digest", what: "A recurring digest of podcast industry news, researched and written up from one saved prompt.", tag: "No more searching" },
  { id: "sog", cat: "content", top: true, title: "School of Greatness", what: "The manual steps between recording and publish-ready files run on their own, including a tool that builds the finished show intro from the host's raw voice track.", tag: "Zero added headcount" },
  { id: "clips", cat: "content", top: true, title: "Clip finder", what: "Finds every time one question gets asked across a YouTube channel's back catalog, cuts the clips and captions them for reposting.", tag: "Back catalog → clips" },
  { id: "archive", cat: "content", title: "Archive chat", what: "Speaker-labelled transcripts of a show's full archive, with a chat window for asking it questions.", tag: "Ask the archive" },
  { id: "retitle", cat: "content", title: "Bulk title review", what: "Checks episode titles against a style guide, lets a person approve the rewrites, then pushes them to the podcast host in bulk.", tag: "Hundreds of edits, one review" },
  { id: "mp3", cat: "content", title: "MP3 metadata processor", what: "A rules engine that tags whole audio libraries with consistent metadata.", tag: "Hours → minutes" },
  { id: "jj", cat: "leads", top: true, title: "JJ Virgin", what: "A protein calculator that gives each visitor a personal number and captures their email.", tag: "List growth on autopilot" },
  { id: "outreach", cat: "leads", title: "Outreach list builder", what: "Turns a workbook of guest questionnaires into a researched outreach list.", tag: "Research → list" },
  { id: "auction", cat: "apps", top: true, title: "School fundraiser", what: "A real-time auction app that replaced a clipboard and a spreadsheet on event night.", tag: "Built in days" },
  { id: "lunch", cat: "apps", title: "Daily lunch-menu email", what: "Fetches a school's menu each morning, emails it to a list kept in a Google Sheet, and handles unsubscribes itself.", tag: "Sends itself daily" },
  { id: "drummer", cat: "apps", title: "Mouth Drummer", what: "Beatbox a drum part into a mic and get a MIDI file back. A personal project, built for fun.", tag: "Voice → MIDI" },
];
const filters = [
  { f: "top", label: "Highlights" },
  { f: "reporting", label: "Reporting & ops" },
  { f: "content", label: "Content at scale" },
  { f: "leads", label: "Leads & sales" },
  { f: "apps", label: "Custom apps" },
  { f: "all", label: `All ${work.length}` },
];
---

<Layout>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header class="bar">
    <div class="wrap bar__in">
      <a href="#top" class="mark">Scott McFall</a>
      <nav aria-label="Main navigation">
        <a href="#offer">Pricing</a>
        <a href="#calculator">Calculator</a>
        <a href="#work">Work</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a href="#book" class="btn btn--sm">Book a free call</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero__copy">
        <p class="eyebrow">For agencies &amp; consulting firms, 5–30 people</p>
        <h1>Your team types the same update into five tools. <em>I automate that.</em></h1>
        <div class="hero__row">
          <p class="lede">One free 30-minute call. Within 48 hours you get a one-page plan for the first workflow to automate, with a fixed price.</p>
          <div class="hero__cta">
            <a href="#book" class="btn">Book a free bottleneck call</a>
            <a href="#offer" class="link">See pricing</a>
          </div>
        </div>
      </div>
      <figure class="hero__video">
        <video id="demo" muted loop playsinline preload="metadata" poster="/demo-poster.jpg" width="1920" height="768"
          aria-label="Animation: one status update is typed once, then lands in an Asana task, a Slack channel, a client email, a budget sheet and a CRM note.">
          <source src="/demo-m.mp4" type="video/mp4" media="(max-width: 640px)" />
          <source src="/demo.mp4?v=2" type="video/mp4" />
        </video>
        <script is:inline>
          // Phones get the taller cut, so its poster and shape have to match.
          if (matchMedia('(max-width: 640px)').matches) {
            var v = document.getElementById('demo');
            v.poster = '/demo-m-poster.jpg'; v.width = 1080; v.height = 1620;
          }
        </script>
        <figcaption>Illustration of a typical build. <button type="button" id="demoToggle" class="link" hidden>Pause</button></figcaption>
      </figure>
    </section>

    <!-- FLOW BAND: five strands become one -->
    <div class="flow" aria-hidden="true">
      <canvas id="flow"></canvas>
      <div class="wrap flow__labels"><span>Five tools, typed by hand</span><span>One update, sent once</span></div>
    </div>

    <p class="trust wrap">Built for <strong>Lewis Howes</strong>, <strong>JJ Virgin</strong> and <strong>Formation Consulting</strong>.</p>

    <!-- OFFER -->
    <section id="offer" class="wrap sec">
      <h2 data-r>One call. One workflow. One fixed price.</h2>
      <ol class="ledger" data-r>
        {offer.map((o) => (
          <li>
            <span class="ledger__name">{o.name}</span>
            <span class="ledger__what">{o.what}</span>
            <span class="ledger__price">{o.price}</span>
          </li>
        ))}
      </ol>
      <p class="note" data-r><strong>Founding clients, 3 spots:</strong> your first automation for $1,500 instead of $2,500, in return for a short case study with your real numbers. <a href="#book" class="link">Ask about a spot</a></p>
    </section>

    <!-- CALCULATOR -->
    <section id="calculator" class="wrap sec">
      <h2 data-r>What's the busywork costing you?</h2>
      <div class="calc" data-r>
        <div class="calc__in">
          <div class="rate">
            <label for="hourlyRate">Hourly cost</label>
            <span>$</span><input type="number" id="hourlyRate" value="50" min="10" max="500" step="5" inputmode="decimal" /><span>/hr</span>
          </div>
          <div class="chips" role="group" aria-label="Add a common task">
            {presets.map((p) => (<button type="button" class="chip" data-task={p}>+ {p}</button>))}
          </div>
          <div class="custom">
            <label for="customTaskInput" class="sr-only">Your own task</label>
            <input type="text" id="customTaskInput" placeholder="Or type your own task" />
            <button type="button" id="addCustomTaskBtn" class="btn btn--sm btn--ghost">Add</button>
          </div>
          <ul id="taskList" class="tasks" aria-label="Your tasks"></ul>
        </div>
        <div class="calc__out" aria-live="polite">
          <p id="resultsEmpty" class="soft">Add a task to see the yearly cost.</p>
          <div id="resultsPanel" hidden>
            <dl>
              <div><dt>Weekly time</dt><dd id="totalHours">0 hrs</dd></div>
              <div><dt>Yearly cost</dt><dd id="annualCost">$0</dd></div>
            </dl>
            <p class="soft small">Back in your pocket over
              <label for="timeHorizon" class="sr-only">Time horizon</label>
              <select id="timeHorizon"><option value="1">1 year</option><option value="3" selected>3 years</option><option value="5">5 years</option></select>
              if about 70% runs on its own (my usual estimate):</p>
            <p class="big" id="totalSavings">$0</p>
            <p class="soft small" id="timeSaved"></p>
            <p class="small proof" id="proof" hidden></p>
            <a href="#book" id="calcCta" class="btn btn--block">Book your free bottleneck call</a>
            <p class="soft small">Your tasks and hours come with you to the booking.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section id="work" class="wrap sec">
      <h2 data-r>Things I've built for real teams.</h2>
      <div class="filts" role="group" aria-label="Filter the work list" data-r>
        {filters.map((x) => (<button type="button" class="filt" data-f={x.f} aria-pressed="false">{x.label}</button>))}
      </div>
      <ul class="work" data-r>
        {work.map((w) => (
          <li id={`w-${w.id}`} data-cat={w.cat} data-top={w.top ? "1" : "0"} style={`view-transition-name: w-${w.id}`}>
            <span class="work__title">{w.title}</span>
            <span class="work__what">{w.what}</span>
            <span class="work__tag">{w.tag}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- BOOK -->
    <section id="book" class="wrap sec">
      <h2 data-r>Pick a time, or tell me what's broken.</h2>
      <p class="soft sub" data-r>30 minutes, no pitch deck. A one-page plan and a fixed price within 48 hours.</p>
      <div class="book" data-r>
        <form action="https://formspree.io/f/xwvnnpoy" method="POST" class="form">
          <div class="form__pair">
            <div><label for="name">Name</label><input id="name" type="text" name="name" required placeholder="Jane Smith" autocomplete="name" /></div>
            <div><label for="email">Email</label><input id="email" type="email" name="email" required placeholder="jane@company.com" autocomplete="email" /></div>
          </div>
          <div>
            <label for="problem">Biggest time-waster right now?</label>
            <select id="problem" name="problem">
              <option value="" disabled selected>Pick one...</option>
              <option>Status updates across tools</option>
              <option>Client reporting</option>
              <option>Client onboarding</option>
              <option>Timesheets, budgets and invoicing</option>
              <option>Proposals</option>
              <option>Leads not followed up</option>
              <option>Something else</option>
            </select>
          </div>
          <div>
            <label for="details">Anything else? (optional)</label>
            <textarea id="details" name="details" rows="4" placeholder="How big is the team? Which tools? What's the most painful part?"></textarea>
          </div>
          <button type="submit" class="btn btn--block">Send message</button>
        </form>
        <div class="calendly-inline-widget cal" data-url="https://calendly.com/scottmcfall/30min?hide_gdpr_banner=1"></div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="wrap sec">
      <h2 data-r>Short answers</h2>
      <div class="faq" data-r>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <p>&copy; 2026 Scott McFall</p>
    <a href="https://github.com/scottmcfalldev-bot" target="_blank" rel="noopener noreferrer">GitHub</a>
  </footer>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

  <script>
    const $ = (id: string) => document.getElementById(id)!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Reveal on entry ──
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-r]').forEach((el) => io.observe(el));

    // ── Demo video: plays only while visible; never autoplays under reduced motion ──
    const demo = $('demo') as HTMLVideoElement;
    const toggle = $('demoToggle') as HTMLButtonElement;
    let userPaused = reduce;
    toggle.hidden = false;
    const sync = () => { toggle.textContent = demo.paused ? 'Play' : 'Pause'; };
    demo.addEventListener('play', sync); demo.addEventListener('pause', sync);
    toggle.addEventListener('click', () => { userPaused = !demo.paused; demo.paused ? demo.play() : demo.pause(); });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) demo.play().catch(() => {});
      else demo.pause();
    }, { threshold: 0.25 }).observe(demo);
    sync();

    // ── Flow band: five strands merge into one ──
    const cv = $('flow') as HTMLCanvasElement;
    const cx = cv.getContext('2d')!;
    let fw = 0, fh = 0, visible = true, scrollV = 0, lastY = scrollY, phase = 0;
    function size() {
      const d = Math.min(devicePixelRatio || 1, 2);
      fw = cv.clientWidth; fh = cv.clientHeight;
      cv.width = fw * d; cv.height = fh * d; cx.setTransform(d, 0, 0, d, 0, 0);
    }
    const smooth = (t: number) => { t = Math.min(1, Math.max(0, t)); return t * t * (3 - 2 * t); };
    const TOOLS = ['#C2643F', '#C99A2E', '#4F6D8F', '#8A5A7A', '#3F8A8A'];   // same five as the video
    const GREEN = '#3F6B4F';
    const MERGE_A = 0.2, MERGE_B = 0.62;                                      // where the strands close up
    function strandY(i: number, x: number, ph: number) {
      const u = x / fw, mid = fh * 0.42;
      const spread = (i - 2) * (fh * 0.15);
      const open = 1 - smooth((u - MERGE_A) / (MERGE_B - MERGE_A));           // 1 = five apart, 0 = merged
      const wob = Math.sin(u * 9 + ph * (0.8 + i * 0.13) + i * 1.7) * fh * 0.055 * open
                + Math.sin(u * 5 - ph * 0.6) * fh * 0.03 * (1 - open);
      return mid + spread * open + wob;
    }
    function paint(ph: number) {
      cx.clearRect(0, 0, fw, fh);
      cx.lineCap = 'round'; cx.lineJoin = 'round';
      for (let i = 0; i < 5; i++) {
        const grad = cx.createLinearGradient(0, 0, fw, 0);
        grad.addColorStop(0, TOOLS[i]);
        grad.addColorStop(MERGE_A + 0.12, TOOLS[i]);
        grad.addColorStop(MERGE_B, GREEN);
        grad.addColorStop(1, GREEN);
        cx.strokeStyle = grad; cx.lineWidth = 2.25;
        cx.beginPath();
        for (let x = -4; x <= fw + 4; x += 5) { const y = strandY(i, x, ph); x < 0 ? cx.moveTo(x, y) : cx.lineTo(x, y); }
        cx.stroke();
      }
      // the single merged line, a little heavier
      cx.strokeStyle = GREEN; cx.lineWidth = 3.5;
      cx.beginPath();
      for (let x = fw * MERGE_B; x <= fw + 4; x += 5) { const y = strandY(2, x, ph); x === fw * MERGE_B ? cx.moveTo(x, y) : cx.lineTo(x, y); }
      cx.stroke();
      // pulses: each tool's colour while apart, green once merged
      for (let i = 0; i < 5; i++) {
        const u = (((ph * 0.1 + i * 0.2) % 1) + 1) % 1, px = u * fw;
        cx.beginPath(); cx.arc(px, strandY(i, px, ph), u > MERGE_B ? 4 : 3.2, 0, 7);
        cx.fillStyle = u > MERGE_B - 0.08 ? GREEN : TOOLS[i]; cx.fill();
      }
    }
    function tick() {
      const dy = scrollY - lastY; lastY = scrollY;
      scrollV += (Math.min(40, Math.abs(dy)) - scrollV) * 0.12;   // scrolling stirs the strands
      phase += 0.012 + scrollV * 0.004;
      if (visible) paint(phase);
      requestAnimationFrame(tick);
    }
    size(); paint(1.3);
    addEventListener('resize', () => { size(); paint(phase || 1.3); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(cv);
    if (!reduce) requestAnimationFrame(tick);

    // ── Calculator ──
    type Task = { id: number; name: string; hours: number };
    const REDUCTION = 0.7;
    let tasks: Task[] = [];
    let nextId = 0;
    const rate = $('hourlyRate') as HTMLInputElement;
    const horizon = $('timeHorizon') as HTMLSelectElement;
    const list = $('taskList');
    const custom = $('customTaskInput') as HTMLInputElement;
    const fmt = (n: number) => (Math.round(n * 10) / 10).toString();

    // Numbers glide to their new value instead of snapping.
    const shown = new Map<string, number>();
    function glide(id: string, to: number, render: (n: number) => string) {
      const el = $(id), from = shown.get(id) ?? 0;
      shown.set(id, to);
      if (reduce || from === to) { el.textContent = render(to); return; }
      const t0 = performance.now();
      const step = (now: number) => {
        if (shown.get(id) !== to) return;
        const k = Math.min(1, (now - t0) / 450), e = 1 - Math.pow(1 - k, 3);
        el.textContent = render(from + (to - from) * e);
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) =>
      b.addEventListener('click', () => { addTask(b.dataset.task!); b.disabled = true; }));
    $('addCustomTaskBtn').addEventListener('click', () => { const v = custom.value.trim(); if (v) { addTask(v); custom.value = ''; } });
    custom.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $('addCustomTaskBtn').click(); } });

    function addTask(name: string) {
      const t = { id: nextId++, name, hours: 2 };
      tasks.push(t);
      const li = document.createElement('li');
      const nm = document.createElement('span'); nm.textContent = name;
      const lab = document.createElement('label');
      const inp = document.createElement('input');
      inp.type = 'number'; inp.min = '0.5'; inp.max = '40'; inp.step = '0.5'; inp.value = '2';
      inp.setAttribute('aria-label', `Hours per week: ${name}`);
      inp.addEventListener('input', () => { t.hours = parseFloat(inp.value) || 0; update(); });
      lab.append(inp, ' hrs/wk');
      const rm = document.createElement('button');
      rm.type = 'button'; rm.textContent = '✕'; rm.setAttribute('aria-label', `Remove ${name}`);
      rm.addEventListener('click', () => {
        tasks = tasks.filter((x) => x.id !== t.id); li.remove();
        const chip = document.querySelector<HTMLButtonElement>(`.chip[data-task="${CSS.escape(name)}"]`);
        if (chip) chip.disabled = false;
        update();
      });
      li.append(nm, lab, rm);
      list.appendChild(li);
      update();
    }

    function update() {
      const has = tasks.length > 0;
      $('resultsPanel').hidden = !has; $('resultsEmpty').hidden = has;
      showProof();
      if (!has) { shown.clear(); return; }
      const r = parseFloat(rate.value) || 0;
      const weekly = tasks.reduce((s, t) => s + t.hours, 0);
      const years = parseInt(horizon.value) || 3;
      const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
      glide('totalHours', weekly, (n) => `${fmt(n)} hrs`);
      glide('annualCost', weekly * 52 * r, money);
      glide('totalSavings', weekly * 52 * r * REDUCTION * years, money);
      $('timeSaved').textContent = `Plus ${Math.round(weekly * 52 * REDUCTION * years).toLocaleString('en-US')} hours of someone's time.`;
    }
    rate.addEventListener('input', update);
    horizon.addEventListener('change', update);

    // ── Work list filters ──
    const filts = document.querySelectorAll<HTMLButtonElement>('.filt');
    const rows = document.querySelectorAll<HTMLElement>('.work li');
    function applyFilter(f: string) {
      rows.forEach((r) => { r.hidden = !(f === 'all' || (f === 'top' ? r.dataset.top === '1' : r.dataset.cat === f)); });
      filts.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    }
    function setFilter(f: string) {
      const d = document as any;
      if (d.startViewTransition && !reduce) d.startViewTransition(() => applyFilter(f)); else applyFilter(f);
    }
    filts.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.f!)));
    applyFilter('top');

    // A calculator task that matches something already built points at it.
    const PROOF: Record<string, string> = {
      'Weekly client reports': 'stats',
      'Status updates across tools': 'formation',
      'Timesheets → invoices': 'formation',
      'Copying data between tools': 'retitle',
      'Lead follow-up & CRM updates': 'outreach',
    };
    function showProof() {
      const ids = [...new Set(tasks.map((t) => PROOF[t.name]).filter(Boolean))].slice(0, 2);
      const el = $('proof');
      el.hidden = ids.length === 0;
      if (!ids.length) return;
      el.replaceChildren('I\'ve built something close: ', ...ids.flatMap((id, i) => {
        const a = document.createElement('a');
        a.href = `#w-${id}`;
        a.textContent = document.querySelector(`#w-${id} .work__title`)!.textContent;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          applyFilter('all');
          const row = $(`w-${id}`);
          row.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
          row.classList.remove('flash'); void row.offsetWidth; row.classList.add('flash');
        });
        return i ? [', ', a] : [a];
      }), '.');
    }

    // ── Calculator → booking ──
    const CALENDLY_URL = 'https://calendly.com/scottmcfall/30min';
    $('calcCta').addEventListener('click', (e) => {
      const r = parseFloat(rate.value) || 0;
      const weekly = tasks.reduce((s, t) => s + t.hours, 0);
      const s = `From the calculator: ${tasks.map((t) => `${t.name} (${t.hours} hrs/wk)`).join('; ')}. Total ${weekly} hrs/week at $${r}/hr, about $${Math.round(weekly * 52 * r).toLocaleString('en-US')}/year.`;
      const details = $('details') as HTMLTextAreaElement;
      if (!details.value.includes('From the calculator')) details.value = details.value ? `${details.value} ${s}` : s;
      const cal = (window as any).Calendly;
      if (cal && typeof cal.initPopupWidget === 'function') {
        e.preventDefault();
        cal.initPopupWidget({ url: `${CALENDLY_URL}?a1=${encodeURIComponent(s)}` });
      }
    });
  </script>
</Layout>

