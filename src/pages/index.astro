  .book__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: 2.5rem; align-items: start; }
  .form { display: grid; gap: 1rem; background: var(--forest-raise); border: 1px solid color-mix(in oklab, var(--forest-ink) 10%, transparent); border-radius: var(--sc-r-md); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: var(--sc-e2); }
