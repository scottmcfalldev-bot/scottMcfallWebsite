  }
  .cross-you strong { color: var(--amber); font-size: 1.3em; font-variant-numeric: tabular-nums; }

  /* 4 · proof (flow + reveal per side) */
  .proof-head, .proof-row { display: grid; grid-template-columns: 1fr 1fr; }
  .proof-head > .side { padding-block: clamp(5rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem); }
  .proof-row > .side { padding-block: clamp(2rem, 4vw, 3.25rem); border-top: 1px solid color-mix(in oklab, currentColor 10%, transparent); }
  .proof-row:last-child > .side { padding-bottom: clamp(5rem, 10vw, 8rem); }
