  .proof-row .soft { margin-top: 0.5rem; max-width: 46ch; }

  /* 5 · the fold */
  .act-fold .stage { display: block; background: var(--forest); }
  .act-fold { --fold: 1; }
  .act-fold .fold-paper {
    position: absolute; inset: 0 auto 0 0; width: 50%;
    transform-origin: left center; transform: scaleX(var(--fold));
    display: grid; align-items: center; justify-items: end;
  }
  .fold-left {
    margin: 0; padding-right: calc(var(--gut) + 1rem); font-family: var(--sc-font-display); font-weight: 700;
    font-size: var(--sc-t-xl); color: var(--paper-soft); letter-spacing: var(--sc-track-snug);
    opacity: clamp(0, (var(--fold) - 0.35) / 0.65, 1);
  }
  .offer {
    position: absolute; top: 50%; left: 50%; width: min(46rem, 100% - 2 * var(--gut));
    transform: translate(calc(-50% + (25vw - 2rem) * var(--fold) * 0.6), -50%);
    display: grid; gap: 1.75rem;
  }
  .ledger { list-style: none; margin: 0; padding: 0; border-top: 1px solid color-mix(in oklab, var(--forest-ink) 18%, transparent); }
