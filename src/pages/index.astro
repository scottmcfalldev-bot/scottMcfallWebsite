---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "What does this cost?",
    a: "The bottleneck call is free. A first automation build is a fixed $2,500 for one workflow, paid 50% up front. Keep It Running is $750 a month. My first three founding clients get the build for $1,500 in exchange for a written case study.",
  },
  {
    q: "Is my client data safe?",
    a: "I work inside your accounts with the least access the job needs, and nothing is copied to my own systems. You can remove my access the day we finish. Happy to sign an NDA before we start.",
  },
  {
    q: "What tools do you use?",
    a: "Whatever fits what you already pay for: Zapier, Make or n8n for the plumbing, Claude for the AI steps, and custom code where those fall short. I connect Asana, Monday, ClickUp, Slack, Google Workspace, HubSpot, Harvest, QuickBooks, Stripe, Airtable and most tools with an API.",
  },
  {
    q: "What happens if it breaks?",
    a: "Every build sends an alert when something fails, so you're not the one who finds out. Fixes are included for 30 days after launch. On Keep It Running, I fix problems within one business day.",
  },
  {
    q: "I'm not technical. Is that a problem?",
    a: "No. You know where the time goes. I handle the tech, and you get a short written guide to what was built and how to change it.",
  },
  {
    q: "How fast?",
    a: "The one-page plan arrives within 48 hours of our call. A build is live in about two weeks.",
  },
  {
    q: "Do you build anything besides automations?",
    a: "Yes. I also build lead-capture tools like calculators and quizzes, and small internal apps. Most agencies start with an automation, though.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// What each common task becomes once it runs on its own.
const runsAs: Record<string, string> = {
  "Status updates across tools": "One update, posted to Asana, Slack and the client thread at once.",
  "Weekly client reports": "Numbers pulled and the report sent every Friday at 9.",
  "New client onboarding setup": "Signed proposal in. Folders, channels and the kickoff invite out.",
  "Timesheets → invoices": "Hours roll into a draft invoice at month end, ready to check.",
  "Building proposals": "A clean first draft from the call notes and your last good proposal.",
  "Meeting notes → tasks": "Action items land in the right project, each with an owner.",
  "Lead follow-up & CRM updates": "Every form fill gets a reply and a CRM record within minutes.",
  "Copying data between tools": "The two tools stay in sync on their own, both directions.",
};
const runsDefault = "Runs on its own, with an alert if it ever fails.";

const defaultTasks = [
  "Status updates across tools",
  "Weekly client reports",
  "New client onboarding setup",
  "Timesheets → invoices",
  "Building proposals",
  "Lead follow-up & CRM updates",
];
const presets = [
  "Status updates across tools",
  "Weekly client reports",
  "New client onboarding setup",
  "Timesheets → invoices",
  "Building proposals",
  "Meeting notes → tasks",
  "Lead follow-up & CRM updates",
  "Copying data between tools",
];

const work = [
  {
    kind: "Operations overhaul · consulting firm",
    title: "Formation Consulting",
    before: "Monday.com for projects, Harvest for hours, spreadsheets for budgets, and invoices built by hand.",
    tag: "~15 hrs/week saved, ~$21k/year (estimated)",
    after: "One integrated system now tracks project financials, sub-contractor budgets and workflows from pipeline through closeout, with no re-entry.",
  },
  {
    kind: "Workflow automation",
    title: "School of Greatness",
    before: "Every episode walked by hand from the recording to publish-ready files.",
    tag: "Faster turnaround, zero added headcount",
    after: "The manual steps between recording and publish run on their own for Lewis Howes' weekly show, so the team keeps pace without growing.",
  },
  {
    kind: "Lead capture",
    title: "JJ Virgin · protein calculator",
    before: "Visitors with a protein question and no reason to leave an email.",
    tag: "Email list growth on autopilot",
    after: "An interactive calculator gives each visitor a personal protein number and captures the email that comes with it.",
  },
  {
    kind: "Custom app",
    title: "Live auction · school fundraiser",
    before: "A clipboard and a spreadsheet on event night.",
    tag: "Replaced clipboard + spreadsheet",
    after: "A real-time bidding app handles every bidder at once, built in days.",
  },
  {
    kind: "Batch automation",
    title: "MP3 metadata processor",
    before: "Hours of tagging audio files one at a time.",
    tag: "Hours → minutes",
    after: "A custom rules engine tags whole audio libraries with consistent metadata in minutes.",
  },
];
---

<Layout>
  <Fragment slot="head">
    <link rel="stylesheet" href="/scrollcraft/scrollcraft.css" />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- The divider is the chrome: both labels, the booking link, and the running hours. -->
  <div class="divider" id="divider" data-sc-verify-state="50|1">
    <span class="divider__line" aria-hidden="true"></span>
    <div class="divider__top">
      <p class="divider__labels" aria-hidden="true"><span>By hand</span><span>Automated</span></p>
      <a class="btn btn--accent btn--sm divider__cta" href="#book">Book a free bottleneck call</a>
    </div>
    <p class="divider__readout" aria-hidden="true">
      <strong id="readoutHours">12</strong> hrs/week by hand
      <span id="readoutSource">· examples</span>
    </p>
  </div>
  <div class="sc-grain" aria-hidden="true"></div>

  <main>
    <!-- 1 · RECOGNITION: the split, both headlines at once -->
    <section class="act-hero" data-sc-act="pin" data-sc-span="1.6">
      <div data-sc-stage class="stage">
        <div class="side side--manual">
          <div class="plane plane--ruling" aria-hidden="true"></div>
          <p class="wordmark">Scott McFall</p>
          <div class="hero-slips" aria-hidden="true">
            <span class="slip slip--loose" style="--x: 8%; --y: 66%; --r: -4deg; --k: 1">Copy status → Slack</span>
            <span class="slip slip--loose" style="--x: 40%; --y: 74%; --r: 3deg; --k: 1.35">Client B report, again</span>
            <span class="slip slip--loose" style="--x: 14%; --y: 83%; --r: 2deg; --k: 1.7">Chase timesheets</span>
            <span class="slip slip--loose" style="--x: 52%; --y: 88%; --r: -2deg; --k: 1.2">New client folders</span>
          </div>
        </div>
        <div class="side side--auto">
          <div class="plane plane--schedule" aria-hidden="true"></div>
          <ul class="hero-runs" aria-hidden="true">
            <li style="--k: 0">Mon 07:00 · status posted to 3 tools</li>
            <li style="--k: 1">Fri 09:00 · Client B report sent</li>
            <li style="--k: 2">Daily · timesheets matched to budget</li>
          </ul>
        </div>

        <h1 class="hero-title">
          <span class="hero-title__a" data-sc-cue="0 0.97 0 0.2">Your team types the same update into five tools.</span>
          <span class="hero-title__b" data-sc-cue="0 0.97 0 0.2">I automate that.</span>
        </h1>
        <div class="hero-sub" data-sc-cue="0 0.97 0 0.2">
          <p>For agencies and consulting firms with 5 to 30 people. One free call, then a one-page plan with a fixed price within 48 hours.</p>
          <a class="btn btn--accent" href="#book">Book a free bottleneck call</a>
        </div>
      </div>
    </section>

    <!-- 2 · UNEASE: their own tasks, priced -->
    <section class="split-flow calc" id="calculator" data-sc-act="flow">
      <div class="side side--manual">
        <div class="col" data-sc-in data-sc-stagger="60">
          <h2 class="h2">Add the tasks eating your team's week.</h2>
          <p class="soft">Pick from the usual ones or type your own. Set the hours. Keep scrolling and you'll see them again.</p>

          <div class="field">
            <label for="hourlyRate">Hourly cost of the person doing it</label>
            <div class="rate">
              <span>$</span>
              <input type="number" id="hourlyRate" value="50" min="10" max="500" step="5" inputmode="decimal" />
              <span>/ hr</span>
            </div>
          </div>

          <div>
            <button id="addTaskBtn" class="btn btn--ghost" type="button" aria-expanded="false" aria-controls="taskPresets">+ Add a task</button>
            <div id="taskPresets" class="presets" hidden>
              <div class="presets__grid">
                {presets.map((p) => (
                  <button type="button" class="preset-btn" data-task={p}>{p}</button>
                ))}
              </div>
              <div class="presets__custom">
                <label for="customTaskInput" class="sr-only">Your own task</label>
                <input type="text" id="customTaskInput" placeholder="Or type your own..." />
                <button id="addCustomTaskBtn" type="button" class="btn btn--ink btn--sm">Add</button>
              </div>
            </div>
          </div>

          <ul id="taskList" class="task-list" aria-label="Your tasks"></ul>
        </div>
      </div>

      <div class="side side--auto">
        <div class="col" data-sc-in data-sc-stagger="60">
          <p class="label">What it costs</p>
          <div id="resultsEmpty" class="soft">Add a task and the yearly cost shows up here.</div>
          <div id="resultsPanel" class="results" hidden>
            <dl class="figures">
              <div>
                <dt>Weekly time spent</dt>
                <dd id="totalHours">0</dd>
                <dd class="soft small" id="weekEquivalent"></dd>
              </div>
              <div>
                <dt>Yearly cost</dt>
                <dd id="annualCost">$0</dd>
              </div>
            </dl>
            <div class="savings">
              <p class="small soft">If about 70% of that runs on its own (my usual estimate; the call gives you a real one), over
                <label for="timeHorizon" class="sr-only">Time horizon</label>
                <select id="timeHorizon">
                  <option value="1">1 year</option>
                  <option value="3" selected>3 years</option>
                  <option value="5">5 years</option>
                </select>
                you get back</p>
              <p class="savings__total" id="totalSavings">$0</p>
              <p class="soft" id="timeSaved">Plus 0 hours</p>
              <ul id="insights" class="insights"></ul>
            </div>
            <a href="#book" id="calcCta" class="btn btn--accent btn--block">Book your free bottleneck call</a>
            <p class="small soft">Your tasks and hours come with you, so we skip the basics on the call.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · RELIEF (peak): the list crosses the line -->
    <section class="act-cross" id="crossing" data-sc-act="pin" data-sc-span="3.2">
      <div data-sc-stage class="stage" id="crossStage" data-sc-verify-state="">
        <div class="side side--manual">
          <p class="label cross-head" id="crossLabel">The usual six (examples)</p>
        </div>
        <div class="side side--auto">
          <p class="label cross-head">Running on its own</p>
        </div>
        <ol class="cross-rows" id="crossRows">
          {defaultTasks.map((t, i) => (
            <li class="cross-row" style={`--i: ${i}`} data-hours="2">
              <span class="slip"><span class="slip__name">{t}</span><span class="slip__hrs">2 hrs/wk</span></span>
              <span class="run">{runsAs[t] ?? runsDefault}</span>
            </li>
          ))}
        </ol>
        <p class="cross-you" data-sc-cue="0.8 0.995 0.06 0.08">
          That's <strong id="crossBack">8.4</strong> hours a week back, at my usual 70% estimate. The call tells you the real number.
        </p>
      </div>
    </section>

    <!-- 4 · TRUST: before and after, for real -->
    <section class="split-flow proof" id="work">
      <div class="proof-head">
        <div class="side side--manual">
          <h2 class="h2 col">Five jobs that used to be done by hand.</h2>
        </div>
        <div class="side side--auto">
          <h2 class="h2 col">Now they run on their own.</h2>
        </div>
      </div>
      {work.map((w) => (
        <article class="proof-row" data-sc-act="flow">
          <div class="side side--manual">
            <div class="col" data-sc-reveal="left" data-sc-reveal-at="0.18 0.5">
              <p class="label">Before</p>
              <p class="proof-before">{w.before}</p>
            </div>
          </div>
          <div class="side side--auto">
            <div class="col" data-sc-reveal="right" data-sc-reveal-at="0.26 0.58">
              <p class="label">{w.kind}</p>
              <h3 class="h3">{w.title}</h3>
              <p class="tag">{w.tag}</p>
              <p class="soft">{w.after}</p>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- 5 · RESOLVE: the paper side folds away -->
    <section class="act-fold" id="offer" data-sc-act="pin" data-sc-span="1.7">
      <div data-sc-stage class="stage">
        <div class="side side--manual fold-paper">
          <p class="fold-left">Or keep doing it by hand.</p>
        </div>
        <div class="offer">
          <h2 class="h2" data-sc-cue="0.32" data-sc-kinetic="lines">One call. One workflow. One fixed price.</h2>
          <ol class="ledger" data-sc-cue="0.42">
            <li><span class="ledger__name">Bottleneck call</span><span class="ledger__what">30 minutes on your week. A one-page plan and a fixed price within 48 hours.</span><span class="ledger__price">Free</span></li>
            <li><span class="ledger__name">First automation</span><span class="ledger__what">One workflow built, tested and handed over in about two weeks. 50% to start. Failure alerts and 30 days of fixes included.</span><span class="ledger__price">$2,500</span></li>
            <li><span class="ledger__name">Keep it running</span><span class="ledger__what">Monitoring, fixes within one business day, small tweaks, one small new automation a month. Optional, cancel any time.</span><span class="ledger__price">$750/mo</span></li>
          </ol>
          <div class="offer__foot" data-sc-cue="0.5">
            <p class="soft"><strong>Founding clients, 3 spots:</strong> your first automation for $1,500, in return for a short case study with your real numbers.</p>
            <a class="btn btn--accent" href="#book">Book a free bottleneck call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · CALM: booking and short answers on the winning ground -->
    <section class="book" id="book" data-sc-act="flow">
      <div class="wrap">
        <div class="book__head" data-sc-in data-sc-stagger="60">
          <h2 class="h2">Pick a time, or tell me what's broken.</h2>
          <p class="soft">30 minutes, no pitch deck. You leave with a one-page plan and a fixed price within 48 hours.</p>
        </div>

        <div class="book__grid">
          <form action="https://formspree.io/f/xwvnnpoy" method="POST" class="form">
            <div class="form__pair">
              <div>
                <label for="name">Name</label>
                <input id="name" type="text" name="name" required placeholder="Jane Smith" autocomplete="name" />
              </div>
              <div>
                <label for="email">Email</label>
                <input id="email" type="email" name="email" required placeholder="jane@company.com" autocomplete="email" />
              </div>
            </div>
            <div>
              <label for="problem">Biggest time-waster right now?</label>
              <select id="problem" name="problem">
                <option value="" disabled selected>Pick one...</option>
                <option>Status updates across tools</option>
                <option>Client reporting</option>
                <option>Client onboarding</option>
                <option>Timesheets, budgets and invoicing</option>
                <option>Proposals</option>
                <option>Leads not followed up</option>
                <option>Something else</option>
              </select>
            </div>
            <div>
              <label for="details">Anything else? (optional)</label>
              <textarea id="details" name="details" rows="4" placeholder="How big is the team? Which tools? What's the most painful part?"></textarea>
            </div>
            <button type="submit" class="btn btn--accent btn--block">Send message</button>
          </form>

          <div class="calendly-inline-widget cal" data-url="https://calendly.com/scottmcfall/30min"></div>
        </div>

        <div class="faq" id="faq">
          <h2 class="h2">Short answers</h2>
          <dl class="faq__list">
            {faqs.map((f) => (
              <div class="faq__item">
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </div>
            ))}
          </dl>
        </div>

        <footer class="foot">
          <p>&copy; 2026 Scott McFall · Workflow automation for small agencies</p>
          <a href="https://github.com/scottmcfalldev-bot" target="_blank" rel="noopener noreferrer">GitHub</a>
        </footer>
      </div>
    </section>
  </main>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline src="/scrollcraft/scrollcraft.js"></script>
  <script is:inline>ScrollCraft.mount(document.body);</script>

  <script define:vars={{ runsAs, runsDefault, defaultTasks }}>
    window.__sm = { runsAs, runsDefault, defaultTasks };
  </script>

  <script>
    const { runsAs, runsDefault, defaultTasks } = (window as any).__sm as {
      runsAs: Record<string, string>; runsDefault: string; defaultTasks: string[];
    };
    const REDUCTION = 0.7;
    const CALENDLY_URL = 'https://calendly.com/scottmcfall/30min';
    const $ = (id: string) => document.getElementById(id)!;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const fmt = (n: number) => (Math.round(n * 10) / 10).toString();

    // ── Calculator ─────────────────────────────────────────────
    type Task = { id: number; name: string; hours: number };
    let tasks: Task[] = [];
    let nextId = 0;

    const rateInput = $('hourlyRate') as HTMLInputElement;
    const addBtn = $('addTaskBtn') as HTMLButtonElement;
    const presetsBox = $('taskPresets');
    const customInput = $('customTaskInput') as HTMLInputElement;
    const list = $('taskList');
    const horizon = $('timeHorizon') as HTMLSelectElement;

    addBtn.addEventListener('click', () => {
      const open = presetsBox.hidden;
      presetsBox.hidden = !open;
      addBtn.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((b) =>
      b.addEventListener('click', () => { addTask(b.dataset.task!); closePresets(); }));
    $('addCustomTaskBtn').addEventListener('click', () => {
      const v = customInput.value.trim();
      if (v) { addTask(v); customInput.value = ''; closePresets(); }
    });
    customInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $('addCustomTaskBtn').click(); } });
    function closePresets() { presetsBox.hidden = true; addBtn.setAttribute('aria-expanded', 'false'); addBtn.focus(); }

    function addTask(name: string) {
      const t = { id: nextId++, name, hours: 2 };
      tasks.push(t);
      const li = document.createElement('li');
      li.className = 'task';
      const label = document.createElement('span');
      label.className = 'task__name';
      label.textContent = name;
      const hrs = document.createElement('label');
      hrs.className = 'task__hrs';
      const input = document.createElement('input');
      input.type = 'number'; input.min = '0.5'; input.max = '40'; input.step = '0.5'; input.value = '2';
      input.setAttribute('aria-label', `Hours per week: ${name}`);
      input.addEventListener('input', () => { t.hours = parseFloat(input.value) || 0; update(); });
      hrs.append(input, document.createTextNode(' hrs/wk'));
      const rm = document.createElement('button');
      rm.type = 'button'; rm.className = 'task__rm'; rm.textContent = '✕';
      rm.setAttribute('aria-label', `Remove ${name}`);
      rm.addEventListener('click', () => { tasks = tasks.filter((x) => x.id !== t.id); li.remove(); update(); });
      li.append(label, hrs, rm);
      list.appendChild(li);
      update();
    }

    function update() {
      const has = tasks.length > 0;
      $('resultsPanel').hidden = !has;
      $('resultsEmpty').hidden = has;
      if (has) {
        const rate = parseFloat(rateInput.value) || 0;
        const weekly = tasks.reduce((s, t) => s + t.hours, 0);
        const annual = weekly * 52 * rate;
        const years = parseInt(horizon.value) || 3;
        const saved = annual * REDUCTION * years;
        const hoursBack = weekly * 52 * REDUCTION * years;
        $('totalHours').textContent = `${fmt(weekly)} hrs`;
        const pct = Math.round((weekly / 40) * 100);
        $('weekEquivalent').textContent = pct > 1 ? `${pct}% of a full-time role` : '';
        $('annualCost').textContent = '$' + Math.round(annual).toLocaleString('en-US');
        $('totalSavings').textContent = '$' + Math.round(saved).toLocaleString('en-US');
        $('timeSaved').textContent = `Plus ${Math.round(hoursBack).toLocaleString('en-US')} hours`;
        const ins: string[] = [];
        const weeks = Math.floor(hoursBack / 40);
        if (weeks >= 1) ins.push(`Free up ${weeks} full work week${weeks > 1 ? 's' : ''}`);
        if (saved >= 10000) ins.push(`Put $${Math.round(saved / 1000)}k back into the business`);
        ins.push(`Drop ${Math.round(weekly * 52 * REDUCTION)} hrs/year of repetitive work`);
        $('insights').replaceChildren(...ins.map((s) => { const li = document.createElement('li'); li.textContent = s; return li; }));
      }
      renderCrossing();
    }
    rateInput.addEventListener('input', update);
    horizon.addEventListener('change', update);

    // ── The crossing: the visitor's own list, or six labelled examples ──
    const rowsEl = $('crossRows');
    let rowData: { hours: number }[] = [];

    function renderCrossing() {
      const mine = tasks.length > 0;
      const src = mine
        ? [...tasks].sort((a, b) => b.hours - a.hours).slice(0, 6)
        : defaultTasks.map((name) => ({ name, hours: 2 }));
      $('crossLabel').textContent = mine ? 'Your list' : 'The usual six (examples)';
      $('readoutSource').textContent = mine ? '· your list' : '· examples';
      rowsEl.replaceChildren(...src.map((t, i) => {
        const li = document.createElement('li');
        li.className = 'cross-row';
        li.style.setProperty('--i', String(i));
        li.style.setProperty('--n', String(src.length));
        const slip = document.createElement('span');
        slip.className = 'slip';
        const nm = document.createElement('span'); nm.className = 'slip__name'; nm.textContent = t.name;
        const hr = document.createElement('span'); hr.className = 'slip__hrs'; hr.textContent = `${fmt(t.hours)} hrs/wk`;
        slip.append(nm, hr);
        const run = document.createElement('span');
        run.className = 'run';
        run.textContent = runsAs[t.name] ?? runsDefault;
        li.append(slip, run);
        return li;
      }));
      rowData = src.map((t) => ({ hours: t.hours }));
      measure();
      frame();
    }

    // ── Calculator → booking ───────────────────────────────────
    function summary() {
      const rate = parseFloat(rateInput.value) || 0;
      const weekly = tasks.reduce((s, t) => s + t.hours, 0);
      const lst = tasks.map((t) => `${t.name} (${t.hours} hrs/wk)`).join('; ');
      return `From the calculator: ${lst}. Total ${weekly} hrs/week at $${rate}/hr, about $${Math.round(weekly * 52 * rate).toLocaleString('en-US')}/year.`;
    }
    $('calcCta').addEventListener('click', (e) => {
      const s = summary();
      const details = $('details') as HTMLTextAreaElement;
      if (!details.value.includes('From the calculator')) details.value = details.value ? `${details.value} ${s}` : s;
      const cal = (window as any).Calendly;
      if (cal && typeof cal.initPopupWidget === 'function') {
        e.preventDefault();
        cal.initPopupWidget({ url: `${CALENDLY_URL}?a1=${encodeURIComponent(s)}` });
      }
    });

    // ── Scroll choreography (page-local, reads the engine's --sc-p) ──
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stacked = matchMedia('(max-width: 819px)');
    const cross = $('crossing');
    const crossStage = $('crossStage');
    const fold = $('offer');
    const book = $('book');
    const divider = $('divider');
    const readout = $('readoutHours');
    const crossBack = $('crossBack');
    const progress = (el: HTMLElement) => parseFloat(el.style.getPropertyValue('--sc-p')) || 0;

    // Each slip travels to the divider: horizontally side by side, vertically when stacked.
    function measure() {
      const rows = rowsEl.querySelectorAll<HTMLElement>('.cross-row');
      const stageBox = crossStage.getBoundingClientRect();
      rows.forEach((row) => {
        const slip = row.querySelector<HTMLElement>('.slip')!;
        slip.style.transform = 'none';
        const r = slip.getBoundingClientRect();
        const dx = stageBox.left + stageBox.width / 2 - r.right - 8;
        const dy = stageBox.top + stageBox.height / 2 - r.bottom - 6;
        row.style.setProperty('--dx', `${Math.max(0, dx)}px`);
        row.style.setProperty('--dy', `${Math.max(0, dy)}px`);
        slip.style.transform = '';
      });
    }

    function rowT(p: number, i: number, n: number) {
      // Crossings spread across 0.08..0.84 of the act, overlapping slightly.
      const step = 0.76 / Math.max(n, 1);
      return ease(clamp((p - 0.08 - i * step) / (step * 1.35)));
    }

    let last = '';
    function frame() {
      const pc = progress(cross);
      const rows = rowsEl.querySelectorAll<HTMLElement>('.cross-row');
      let left = 0, total = 0;
      const sig: string[] = [];
      rows.forEach((row, i) => {
        const t = rowT(pc, i, rows.length);
        row.style.setProperty('--t', t.toFixed(3));
        const h = rowData[i]?.hours ?? 0;
        total += h;
        left += h * (1 - REDUCTION * t);
        sig.push(t.toFixed(2));
      });
      crossStage.setAttribute('data-sc-verify-state', sig.join(','));

      // Before the crossing the readout shows the full list; after it, what's left.
      const hours = cross.getBoundingClientRect().top > innerHeight ? total : left;
      const txt = fmt(hours);
      if (txt !== last) { readout.textContent = txt; last = txt; }
      crossBack.textContent = fmt(total * REDUCTION);

      // The fold: paper side collapses, divider sweeps to the left edge and goes.
      const pf = progress(fold);
      const f = 1 - ease(clamp((pf - 0.08) / 0.5));
      fold.style.setProperty('--fold', f.toFixed(4));
      const afterBook = book.getBoundingClientRect().top < innerHeight * 0.5;
      const split = stacked.matches ? 0 : 50 * f;
      divider.style.setProperty('--split', `${split}`);
      divider.style.opacity = afterBook || f < 0.02 ? '0' : '1';
      divider.style.visibility = afterBook || f < 0.02 ? 'hidden' : 'visible';
      divider.setAttribute('data-sc-verify-state', `${split.toFixed(1)}|${f.toFixed(2)}`);
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; frame(); });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => { measure(); frame(); });
    document.fonts?.ready.then(() => { measure(); frame(); });
    rowData = defaultTasks.map(() => ({ hours: 2 }));
    if (reduce) document.documentElement.classList.add('is-reduced');
    measure();
    frame();
  </script>
</Layout>

<style is:global>
