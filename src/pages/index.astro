---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "What does this cost?",
    a: "The bottleneck call is free. A first automation build is a fixed $2,500 for one workflow, paid 50% up front. Keep It Running is $750 a month. My first three founding clients get the build for $1,500 in exchange for a written case study.",
  },
  {
    q: "Is my client data safe?",
    a: "I work inside your accounts with the least access the job needs, and nothing is copied to my own systems. You can remove my access the day we finish. Happy to sign an NDA before we start.",
  },
  {
    q: "What tools do you use?",
    a: "Whatever fits what you already pay for: Zapier, Make or n8n for the plumbing, Claude for the AI steps, and custom code where those fall short. I connect Asana, Monday, ClickUp, Slack, Google Workspace, HubSpot, Harvest, QuickBooks, Stripe, Airtable and most tools with an API.",
  },
  {
    q: "What happens if it breaks?",
    a: "Every build sends an alert when something fails, so you're not the one who finds out. Fixes are included for 30 days after launch. On Keep It Running, I fix problems within one business day.",
  },
  {
    q: "I'm not technical. Is that a problem?",
    a: "No. You know where the time goes. I handle the tech, and you get a short written guide to what was built and how to change it.",
  },
  {
    q: "How fast?",
    a: "The one-page plan arrives within 48 hours of our call. A build is live in about two weeks.",
  },
  {
    q: "Do you build anything besides automations?",
    a: "Yes. I also build lead-capture tools like calculators and quizzes, and small internal apps. Most agencies start with an automation, though.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- ── NAV ── -->
  <header class="sticky top-0 z-50 bg-[#FAFAF9]/85 backdrop-blur-[16px] border-b border-[#E7E5E4]">
    <div class="max-w-[1000px] mx-auto px-7 py-3.5 flex items-center justify-between">
      <span class="font-[800] text-[17px] tracking-[-0.5px] text-[#1C1917]">Scott McFall</span>
      <nav aria-label="Main navigation" class="hidden sm:flex items-center gap-8">
        <a href="#problems" class="nav-link text-[13px] font-medium tracking-[0.3px] uppercase text-[#78716C] hover:text-[#1C1917] transition-colors">Problems</a>
        <a href="#offer" class="nav-link text-[13px] font-medium tracking-[0.3px] uppercase text-[#78716C] hover:text-[#1C1917] transition-colors">Pricing</a>
        <a href="#work" class="nav-link text-[13px] font-medium tracking-[0.3px] uppercase text-[#78716C] hover:text-[#1C1917] transition-colors">Work</a>
        <a href="#faq" class="nav-link text-[13px] font-medium tracking-[0.3px] uppercase text-[#78716C] hover:text-[#1C1917] transition-colors">FAQ</a>
      </nav>
      <a
        href="#contact"
        class="text-[13px] font-semibold bg-[#1C1917] text-[#FAFAF9] px-5 py-2.5 rounded-md hover:bg-[#44403C] transition-all tracking-[0.2px] whitespace-nowrap"
      >
        Book a Free Call
      </a>
    </div>
  </header>

  <main>
    <!-- ── HERO ── -->
    <section class="max-w-[1000px] mx-auto px-7 pt-[100px] pb-20">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-12">
        <!-- Left: copy -->
        <div class="lg:max-w-[540px]">
          <p class="fade-up text-[12px] font-bold tracking-[2.5px] uppercase text-[#4A6741] mb-6" style="animation-delay: 0ms">For agencies &amp; consulting firms, 5–30 people</p>
          <h1 class="fade-up text-[clamp(34px,5vw,54px)] font-[900] leading-[1.05] tracking-[-2px] text-[#1C1917] mb-6" style="animation-delay: 80ms">
            Your team types the same update into five tools.<br><span class="text-[#4A6741]">I automate that.</span>
          </h1>
          <p class="fade-up text-[17px] text-[#78716C] mb-9 max-w-[480px] leading-[1.65]" style="animation-delay: 160ms">
            Status updates, client onboarding, weekly reports, timesheets to invoices. Book a free 30-minute call. Within 48 hours you get a one-page plan for the first workflow to automate, with a fixed price.
          </p>
          <div class="fade-up flex gap-3 flex-wrap" style="animation-delay: 240ms">
            <a href="#contact" class="inline-block bg-[#1C1917] text-[#FAFAF9] font-semibold px-6 py-2.5 rounded-md hover:bg-[#44403C] transition-all text-[13px] tracking-[0.2px]">
              Book a free bottleneck call
            </a>
            <a href="#offer" class="inline-block bg-transparent text-[#1C1917] font-semibold px-6 py-2.5 rounded-md border-[1.5px] border-[#D6D3D1] hover:border-[#1C1917] transition-all text-[13px] tracking-[0.2px]">
              See what it costs
            </a>
          </div>
        </div>

        <!-- Right: savings proof card -->
        <div class="fade-up lg:max-w-[340px] w-full" style="animation-delay: 300ms">
          <div class="bg-[#F5F5F4] border border-[#E7E5E4] rounded-2xl p-7 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-[3px] bg-[#4A6741]"></div>
            <p class="text-[11px] font-bold tracking-[2px] uppercase text-[#4A6741] mb-4">Client result · consulting firm</p>
            <p class="text-[40px] font-[900] tracking-[-1.5px] text-[#1C1917] leading-none mb-1">$21k+</p>
            <p class="text-[14px] text-[#78716C] mb-5">estimated savings per year</p>
            <div class="space-y-3 pt-4 border-t border-[#E7E5E4]">
              <div class="flex items-baseline justify-between">
                <span class="text-[13px] text-[#57534E]">Hours reclaimed weekly</span>
                <span class="text-[15px] font-[800] text-[#1C1917]">15+</span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-[13px] text-[#57534E]">Tools replaced</span>
                <span class="text-[15px] font-[800] text-[#1C1917]">5 → 1</span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-[13px] text-[#57534E]">Manual processes cut</span>
                <span class="text-[15px] font-[800] text-[#1C1917]">80%</span>
              </div>
            </div>
            <p class="text-[11px] text-[#A8A29E] mt-4 italic">Formation Consulting. Estimated from hours saved, not audited.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TRUST BAR ── -->
    <section class="border-t border-b border-[#E7E5E4] bg-[#F5F5F4] py-[18px]">
      <div class="max-w-[1000px] mx-auto px-7 text-center">
        <p class="text-[13px] text-[#A8A29E] font-medium">
          Worked with <strong class="text-[#57534E] font-semibold">Lewis Howes</strong>,
          <strong class="text-[#57534E] font-semibold">JJ Virgin</strong>,
          and <strong class="text-[#57534E] font-semibold">Formation Consulting</strong>.
        </p>
      </div>
    </section>

    <!-- ── PAIN POINTS ── -->
    <section id="problems" class="bg-[#F0F4EE] border-b border-[#E7E5E4] py-20">
      <div class="max-w-[1000px] mx-auto px-7">
        <p class="text-[12px] font-bold tracking-[2.5px] uppercase text-[#4A6741] mb-3">Sound Familiar?</p>
        <h2 class="text-[36px] font-[800] tracking-[-1px] text-[#1C1917] mb-2">Where agency hours quietly go.</h2>
        <p class="text-[15px] text-[#78716C] mb-12">None of this is billable. All of it can run on its own.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-[#D6D3D1] border border-[#D6D3D1] rounded-xl overflow-hidden">
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 0ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Status updates live in five places</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">The same project update goes into Asana, Slack, the client email and the spreadsheet. By hand. Every day.</p>
          </div>
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 80ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Client reports eat Friday</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">Someone pulls numbers from three tools, pastes them into a deck, and sends it. Every client, every week.</p>
          </div>
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 160ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Onboarding is a checklist in someone's head</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">New client signs. Folders, channels, intake forms and kickoff invites get set up from memory, and something gets missed.</p>
          </div>
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 240ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Timesheets don't match invoices</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">Hours live in Harvest, budgets in a spreadsheet, invoices in QuickBooks. Month-end is a reconciliation project.</p>
          </div>
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 320ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Proposals start from a blank page</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">Every proposal is rebuilt from the last one, with old client names left in. Hours per deal you never bill for.</p>
          </div>
          <div class="cell-fade bg-white/85 p-8 transition-all duration-300 hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(74,103,65,0.1)] hover:z-10 hover:relative group" style="animation-delay: 400ms">
            <h3 class="text-[15px] font-bold mb-2 leading-tight group-hover:text-[#4A6741] transition-colors">Leads go quiet after the form</h3>
            <p class="text-[13px] text-[#78716C] leading-relaxed">Someone fills out your contact form and then nothing happens until a person remembers to reply.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── OFFER ── -->
    <section id="offer" class="bg-[#F5F5F4] border-b border-[#E7E5E4] py-20">
      <div class="max-w-[1000px] mx-auto px-7">
        <p class="text-[12px] font-bold tracking-[2.5px] uppercase text-[#4A6741] mb-3">How to Start</p>
        <h2 class="text-[36px] font-[800] tracking-[-1px] text-[#1C1917] mb-2">One call. One workflow. One fixed price.</h2>
        <p class="text-[15px] text-[#78716C] mb-12">Start small, see it work, then decide if you want more.</p>
        <div class="grid sm:grid-cols-3 gap-5">
          <div class="scroll-fade bg-[#FAFAF9] rounded-xl p-7 border-2 border-[#4A6741] relative flex flex-col">
            <p class="text-[11px] font-bold tracking-[2px] uppercase text-[#4A6741] mb-2">Step 1</p>
            <h3 class="text-[19px] font-[800] tracking-[-0.5px] mb-1">Bottleneck Call</h3>
            <p class="text-[28px] font-[900] tracking-[-1px] text-[#1C1917] mb-3">Free</p>
            <p class="text-[13px] text-[#78716C] leading-relaxed mb-5">30 minutes walking through your team's week. Within 48 hours you get a one-page plan: the first workflow to automate, the hours it saves, and a fixed price.</p>
            <a href="#contact" class="mt-auto block text-center bg-[#1C1917] text-[#FAFAF9] font-semibold px-5 py-2.5 rounded-md hover:bg-[#44403C] transition-colors text-[13px]">Book the call</a>
          </div>
          <div class="scroll-fade bg-[#FAFAF9] rounded-xl p-7 border border-[#E7E5E4] flex flex-col" style="animation-delay: 80ms">
            <p class="text-[11px] font-bold tracking-[2px] uppercase text-[#4A6741] mb-2">Step 2</p>
            <h3 class="text-[19px] font-[800] tracking-[-0.5px] mb-1">First Automation</h3>
            <p class="text-[28px] font-[900] tracking-[-1px] text-[#1C1917] mb-3">$2,500</p>
            <p class="text-[13px] text-[#78716C] leading-relaxed">One workflow built, tested and handed over in about two weeks. Fixed scope, 50% to start. Failure alerts and 30 days of fixes included.</p>
          </div>
          <div class="scroll-fade bg-[#FAFAF9] rounded-xl p-7 border border-[#E7E5E4] flex flex-col" style="animation-delay: 160ms">
            <p class="text-[11px] font-bold tracking-[2px] uppercase text-[#4A6741] mb-2">Step 3 · optional</p>
            <h3 class="text-[19px] font-[800] tracking-[-0.5px] mb-1">Keep It Running</h3>
            <p class="text-[28px] font-[900] tracking-[-1px] text-[#1C1917] mb-3">$750<span class="text-[15px] font-semibold text-[#78716C]">/mo</span></p>
            <p class="text-[13px] text-[#78716C] leading-relaxed">Monitoring, fixes within one business day, small tweaks, and one small new automation each month. Cancel any time.</p>
          </div>
        </div>
        <div class="scroll-fade mt-6 rounded-xl bg-[#F0F4EE] border border-[#D6D3D1] p-6 sm:flex sm:items-center sm:justify-between gap-6">
          <div>
            <p class="text-[11px] font-bold tracking-[2px] uppercase text-[#4A6741] mb-1">Founding clients · 3 spots</p>
            <p class="text-[15px] text-[#1C1917] font-semibold mb-1">Your first automation for $1,500 instead of $2,500.</p>
            <p class="text-[13px] text-[#78716C]">In return: a short written case study with your real before-and-after numbers, and permission to name your firm.</p>
          </div>
          <a href="#contact" class="mt-4 sm:mt-0 inline-block shrink-0 bg-[#4A6741] text-white font-semibold px-5 py-2.5 rounded-md hover:bg-[#3A5233] transition-colors text-[13px]">Ask about a spot</a>
        </div>
      </div>
    </section>

    <!-- ── ROI CALCULATOR ── -->
    <section class="border-b border-[#E7E5E4] bg-[#1C1917] text-[#FAFAF9]">
      <div class="max-w-[1000px] mx-auto px-7 py-20">
        <p class="text-[12px] font-bold tracking-[2.5px] uppercase text-[#4A6741] mb-3">Calculator</p>
        <h2 class="text-[36px] font-[800] tracking-[-1px] text-[#FAFAF9] mb-2">What's the busywork costing you?</h2>
        <p class="text-[15px] text-[#A8A29E] mb-9">Add the tasks eating your time. See the real number.</p>

        <div class="grid sm:grid-cols-2 gap-4 mb-5">
          <div class="bg-[#292524] rounded-[10px] p-6 border border-[#44403C]">
            <label for="hourlyRate" class="block text-[13px] font-semibold text-[#D6D3D1] mb-2.5">Hourly rate (yours or your team member's)</label>
            <div class="flex items-center gap-2">
              <span class="text-[18px] text-[#A8A29E]">$</span>
              <input
                type="number"
                id="hourlyRate"
                value="50"
                min="10"
                max="500"
                step="5"
                class="text-[28px] font-[800] text-[#FAFAF9] bg-transparent border-0 border-b-2 border-[#4A6741] focus:outline-none w-[90px] font-sans"
              />
              <span class="text-[18px] text-[#A8A29E]">/ hr</span>
            </div>
          </div>
          <button
            id="addTaskBtn"
            class="bg-[#292524] border border-[#44403C] text-[#D6D3D1] font-semibold text-[15px] rounded-[10px] p-6 hover:bg-[#44403C] hover:text-[#FAFAF9] transition-all cursor-pointer"
          >
            + Add a Task
          </button>
        </div>

        <!-- Task Presets -->
        <div id="taskPresets" class="hidden bg-[#292524] border border-[#44403C] rounded-[10px] p-6 mb-5">
          <p class="text-[13px] font-semibold text-[#D6D3D1] mb-3">Pick a common task or add your own:</p>
          <div class="grid sm:grid-cols-2 gap-2">
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Status updates across tools">Status updates across tools</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Weekly client reports">Weekly client reports</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="New client onboarding setup">New client onboarding setup</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Timesheets → invoices">Timesheets → invoices</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Building proposals">Building proposals</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Meeting notes → tasks">Meeting notes → tasks</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Lead follow-up & CRM updates">Lead follow-up &amp; CRM updates</button>
            <button class="preset-btn text-left px-3.5 py-2.5 rounded-md bg-[#44403C] text-[#E7E5E4] hover:bg-[#4A6741] hover:text-white transition-all text-[13px] cursor-pointer" data-task="Copying data between tools">Copying data between tools</button>
          </div>
          <div class="mt-3.5 pt-3.5 border-t border-[#44403C]">
            <input
              type="text"
              id="customTaskInput"
              placeholder="Or type your own..."
              class="w-full px-3 py-2.5 rounded-md border border-[#44403C] bg-[#292524] text-[13px] text-[#FAFAF9] placeholder-[#78716C] focus:outline-none focus:border-[#4A6741] mb-2"
            />
            <button id="addCustomTaskBtn" class="w-full py-2.5 rounded-md bg-[#4A6741] text-white font-semibold text-[13px] hover:bg-[#3A5233] transition-colors cursor-pointer">Add Custom Task</button>
          </div>
        </div>

        <!-- Task List -->
        <div id="taskList" class="space-y-2.5 mb-5"></div>

        <!-- Results Panel -->
        <div id="resultsPanel" class="hidden bg-[#292524] border border-[#44403C] rounded-xl p-7">
          <div class="grid sm:grid-cols-2 gap-5 mb-5">
            <div>
              <p class="text-[12px] text-[#A8A29E] mb-1 uppercase tracking-[1px] font-semibold">Weekly time spent</p>
              <p class="text-[32px] font-[800] text-[#FAFAF9]" id="totalHours">0</p>
              <p class="text-[12px] text-[#78716C] mt-0.5" id="weekEquivalent"></p>
            </div>
            <div>
              <p class="text-[12px] text-[#A8A29E] mb-1 uppercase tracking-[1px] font-semibold">Annual cost</p>
              <p class="text-[32px] font-[800] text-[#FAFAF9]" id="annualCost">$0</p>
            </div>
          </div>

          <div class="border-t border-[#44403C] pt-5">
            <div class="flex items-center justify-between mb-1.5">
              <p class="text-[12px] text-[#A8A29E] uppercase tracking-[1px] font-semibold">Potential savings</p>
              <span class="text-[11px] font-bold bg-[#4A6741] text-white px-2.5 py-0.5 rounded-[10px]">~70% time reduction</span>
            </div>
            <p class="text-[12px] text-[#78716C] mb-3">Most automations save 60–80%. You still review — the heavy lifting is handled.</p>
            <div class="flex items-center gap-2 mb-3">
              <label for="timeHorizon" class="text-[13px] font-semibold text-[#E7E5E4]">Over</label>
              <select id="timeHorizon" class="bg-[#44403C] border border-[#57534E] rounded px-2.5 py-1 text-[13px] font-semibold text-[#F5F5F4] focus:outline-none">
                <option value="1">1 year</option>
                <option value="3" selected>3 years</option>
                <option value="5">5 years</option>
              </select>
            </div>
            <p class="text-[40px] font-[900] text-[#4A6741] mb-1 tracking-[-1px]" id="totalSavings">$0</p>
            <p class="text-[13px] text-[#A8A29E]" id="timeSaved">Plus 0 hours back</p>
          </div>

          <div class="mt-4 pt-4 border-t border-[#44403C]">
            <p class="text-[12px] text-[#A8A29E] mb-2 uppercase tracking-[1px] font-semibold">That's enough to:</p>
            <div id="insights" class="space-y-1"></div>
          </div>

          <a
            href="#contact"
            id="calcCta"
            class="mt-5 block w-full bg-[#4A6741] text-white font-semibold px-6 py-3.5 rounded-md hover:bg-[#3A5233] transition-colors text-center text-[13px]"
          >
            Book your free bottleneck call →
          </a>
          <p class="text-[12px] text-[#78716C] mt-2 text-center">Your tasks and hours come with you, so we skip the basics on the call.</p>
        </div>
      </div>
    </section>

    <!-- ── WORK ── -->
    <section id="work" class="border-b border-[#E7E5E4] py-20">
      <div class="max-w-[1000px] mx-auto px-7">
        <p class="text-[12px] font-bold tracking-[2.5px] uppercase text-[#4A6741] mb-3">Recent Work</p>
        <h2 class="text-[36px] font-[800] tracking-[-1px] text-[#1C1917] mb-12">Things I've built for real teams.</h2>

        <div class="grid sm:grid-cols-2 gap-5">
          <!-- Featured: Formation -->
          <div class="scroll-fade sm:col-span-2 border border-[#E7E5E4] rounded-[10px] p-7 bg-[#FAFAF9] hover:border-[#4A6741] transition-all">
