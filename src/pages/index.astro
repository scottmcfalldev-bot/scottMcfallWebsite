  .ledger__price { font-family: var(--sc-font-display); font-weight: 800; font-size: var(--sc-t-lg); font-variant-numeric: tabular-nums; color: var(--amber); white-space: nowrap; }
  .offer__foot { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center; justify-content: space-between; }
  .offer__foot p { margin: 0; max-width: 46ch; font-size: var(--sc-t-sm); }
