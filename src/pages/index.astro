  .form input, .form select, .form textarea {
    width: 100%; background: var(--forest); color: var(--forest-ink); border: 1px solid color-mix(in oklab, var(--forest-ink) 22%, transparent);
    border-radius: var(--sc-r-sm); padding: 0.75em 0.85em; font-size: var(--sc-t-sm);
  }
